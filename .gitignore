# Dependencias Node.js
node_modules/

# Servidor local (no necesario en GitHub Pages)
server.js
package.json
package-lock.json

# GeoVisor local (versión de desarrollo con servidor)
GEOVISOR CAECH.html

# DATA SET: excluir todo excepto los GeoJSON que consume el GeoVisor
DATA SET/CATASTRO RIOBAMBA FEB 2026/
DATA SET/CERTIFICACION_EJES_VIALES.gdb/
DATA SET/EERSA/
DATA SET/*.csv
DATA SET/*.zip
DATA SET/*.qmd

# Descargas crudas de EMAPAR en EPSG:32717 (CAD). El visor consume las capas
# ya reproyectadas que produce RESEARCH/build_servicios_basicos.js:
# "DATA SET/agua_potable.geojson" y "DATA SET/alcantarillado.geojson".
DATA SET/Cobertura Agua Potable.geojson
DATA SET/Alcantarillado Sanitario.geojson
DATA SET/Alcantarillado Fluvial.geojson
DATA SET/Alcantarillado Combinado.geojson
ENLACES GEOPORTALES/

# Descarga cruda de predios (95 MB) que ninguna capa del visor referencia.
# El visor usa "DATA SET/Catastro GADMR.geojson".
DATA SET/Predios.geojson

# Levantamientos topograficos de referencia (DXF de estacion total).
# Sirven de patron para test/fixtures pero no se publican: el repositorio
# es publico y son documentos de trabajo del CAE-CH.
FIX/

# RESEARCH - datos crudos pesados (>50MB, no necesarios en producción)
RESEARCH/CONSTRUCCIONES DETECTADAS POR IA.geojson
RESEARCH/PREDIOS PRIVADOS RESEARCH .geojson
RESEARCH/Google buildings.qgz
RESEARCH/CONSTRUCCIONES DETECTADAS POR IA.qmd
RESEARCH/PUGS Urbano Research.geojson
RESEARCH/preprocess.js
RESEARCH/build_construcciones_ia.js

# Respaldos y configuración local
*.bak
.claude/

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db
