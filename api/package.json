{
  "name": "caech-afiliados",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de afiliados del CAE-CH sobre Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "esquema:local": "wrangler d1 execute caech-afiliados --local --file=schema.sql",
    "esquema:remoto": "wrangler d1 execute caech-afiliados --remote --file=schema.sql",
    "tail": "wrangler tail",
    "test": "node test/api.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
